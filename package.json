{
  "name": "codesip",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch server/main.ts",
    "dev:web": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "build": "node scripts/build.mjs",
    "start": "node dist/server/main.mjs",
    "plugin:build": "node scripts/build-plugin.mjs",
    "release": "node scripts/release.mjs",
    "format": "prettier --write \"server/**/*.ts\" \"shared/**/*.ts\" \"web/**/*.{ts,tsx,css,js,html,json,webmanifest}\" \"plugin/**/*.{ts,json,css}\" \"scripts/*.mjs\" \"tests/**/*.ts\" \"*.ts\" \"*.json\""
  },
  "dependencies": {
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/language-data": "^6.5.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@fastify/cookie": "11.1.5",
    "@fastify/multipart": "10.1.9",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/static": "10.1.12",
    "codemirror": "6.0.2",
    "fastify": "5.12.8",
    "lucide-react": "1.76.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "4.0.1",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/yauzl": "^2.10.3",
    "@vitejs/plugin-react": "6.3.0",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "obsidian": "1.14.4",
    "prettier": "^3.10.1",
    "tsx": "4.23.15",
    "typescript": "~5.9.3",
    "vite": "8.3.8"
  }
}
